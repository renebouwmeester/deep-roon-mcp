{
  "name": "deep-roon-mcp",
  "version": "0.5.9",
  "description": "An MCP server for Roon that reaches the parts the official API doesn't: reviews, biographies, Qobuz's and TIDAL's shelves, TIDAL's playlists, your history, search across your library and the streaming services",
  "license": "Apache-2.0",
  "author": "René Bouwmeester <21277119+renebouwmeester@users.noreply.github.com>",
  "homepage": "https://github.com/renebouwmeester/deep-roon-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renebouwmeester/deep-roon-mcp.git"
  },
  "keywords": [
    "roon",
    "mcp",
    "model-context-protocol",
    "claude",
    "qobuz",
    "tidal",
    "music"
  ],
  "type": "commonjs",
  "bin": {
    "deep-roon-mcp": "dist/deep-roon-mcp.js"
  },
  "files": [
    "dist/deep-roon-mcp.js",
    "dist/THIRD_PARTY_LICENSES.txt",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "node dist/deep-roon-mcp.js",
    "bundle": "node scripts/bundle.mjs",
    "prepublishOnly": "node scripts/build.mjs",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "node-roon-api": "github:roonlabs/node-roon-api",
    "node-roon-api-transport": "github:roonlabs/node-roon-api-transport",
    "typescript": "^7.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  }
}
