{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ]
}
